{
  "manifest_version": 3,
  "name": "AliExpress Coins Auto-Collector",
  "version": "1.0.0",
  "description": "Automatically collects daily coins and bonus tasks on AliExpress",
  "permissions": [
    "alarms",
    "storage",
    "cookies",
    "scripting",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "*://*.aliexpress.com/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_1",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": ["*://*.aliexpress.com/*coin*"],
      "js": ["mobile_shim.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "AliExpress Coins Auto-Collector"
  }
}
